---
import SectionHead from './SectionHead.astro';
import { useTranslations, type Lang, type TKey } from '../i18n/utils';

interface Props {
  lang: Lang;
  class?: string;
}

const { lang, class: className } = Astro.props;
const t = useTranslations(lang);

const projects: { title: string; url: string; tag: TKey; desc: TKey }[] = [
  { title: 'Thalia Lustrum Festival', url: 'https://evo439.github.io/Lustrum-Festival2/', tag: 'port_tag_1', desc: 'port_desc_1' },
  { title: 'Interactive Resume', url: 'https://roelnijhuis.nl', tag: 'port_tag_2', desc: 'port_desc_2' },
];
---

<section id="portfolio" class:list={['bg-mist py-20 sm:py-28', className]} aria-labelledby="portfolio-title">
  <div class="wrap grid gap-12">
    <SectionHead id="portfolio-title" title={t('port_title')} subtitle={t('port_subtitle')} />
    <ul class="ruled">
      {
        projects.map((p) => (
          <li class="grid gap-3 py-8 md:grid-cols-[minmax(0,16rem)_minmax(0,1fr)_auto] md:items-baseline md:gap-10">
            <div class="grid gap-1">
              <h3 class="h3">{p.title}</h3>
              <p class="font-display text-sm font-semibold text-steel">{t(p.tag)}</p>
            </div>
            <p class="max-w-[58ch] text-slate">{t(p.desc)}</p>
            <a href={p.url} target="_blank" rel="noopener noreferrer" class="link justify-self-start">
              {t('port_btn')}
              <span class="sr-only">: {p.title}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
