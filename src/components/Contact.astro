---
import SectionHeader from './SectionHeader.astro';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  /** Standalone contact page: form title becomes the page's h1, no section header */
  standalone?: boolean;
}

const { lang, standalone = false } = Astro.props;
const t = useTranslations(lang);
const Title = standalone ? 'h1' : 'h3';
const messages = {
  sending: t('form_sending'),
  sent: t('form_sent'),
  error: t('form_error'),
  failed: t('form_failed'),
};
---

<section id="contact" class="contact">
  {
    !standalone && (
      <div class="container">
        <SectionHeader title={t('contact_section_title')} subtitle={t('contact_section_subtitle')} />
      </div>
    )
  }
  <div class="container contact-container glass-panel fade-up">
    <div class="contact-info">
      <Title set:html={t('contact_title')} />
      <p>{t('contact_subtitle')}</p>
    </div>
    <form
      action="https://api.web3forms.com/submit"
      method="POST"
      class="contact-form"
      data-contact-form
      data-messages={JSON.stringify(messages)}
    >
      <input type="hidden" name="access_key" value="9a0f52ef-0b63-43bf-ac1f-6d82a42c3c98" />
      <div class="form-group">
        <input type="text" name="name" id="name" required placeholder={t('contact_ph_name')} aria-label={t('contact_ph_name')} autocomplete="name" />
      </div>
      <div class="form-group">
        <input type="email" name="email" id="email" required placeholder={t('contact_ph_email')} aria-label={t('contact_ph_email')} autocomplete="email" />
      </div>
      <div class="form-group">
        <select name="subject" id="subject" required aria-label={t('contact_ph_subject')}>
          <option value="" disabled selected>{t('contact_ph_subject')}</option>
          <option value="Website bouwen">{t('contact_opt_website')}</option>
          <option value="SEO Rapport">{t('contact_opt_seo')}</option>
          <option value="Overig">{t('contact_opt_other')}</option>
        </select>
      </div>
      <div class="form-group">
        <textarea name="message" id="message" rows="4" required placeholder={t('contact_ph_msg')} aria-label={t('contact_ph_msg')}></textarea>
      </div>
      <button type="submit" class="btn btn-primary btn-full">{t('contact_btn')}</button>
    </form>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const msg = JSON.parse(form.dataset.messages!);
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const originalText = btn.textContent;

    btn.textContent = msg.sending;
    btn.disabled = true;

    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      });

      if (res.status === 200) {
        btn.classList.add('btn-success');
        btn.textContent = msg.sent;
        form.reset();
      } else {
        console.error(res);
        btn.classList.add('btn-error');
        btn.textContent = msg.error;
      }
    } catch (err) {
      console.error(err);
      btn.classList.add('btn-error');
      btn.textContent = msg.failed;
    } finally {
      setTimeout(() => {
        btn.textContent = originalText;
        btn.disabled = false;
        btn.classList.remove('btn-success', 'btn-error');
      }, 3000);
    }
  });
</script>
