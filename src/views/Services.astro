---
import Base from '../layouts/Base.astro';
import Packages from '../components/Packages.astro';
import ServicesSection from '../components/Services.astro';
import CheckTeaser from '../components/CheckTeaser.astro';
import type { Lang } from '../i18n/utils';

const { lang } = Astro.props as { lang: Lang };
---

<Base lang={lang} page="services">
  <Packages lang={lang} headingLevel="h1" tone="sky" class="!pt-10" />
  <CheckTeaser lang={lang} />
  <ServicesSection lang={lang} class="bg-mist [--illu-bg:var(--color-mist)]" />
</Base>
