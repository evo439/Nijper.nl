---
import SectionHead from './SectionHead.astro';
import ServiceIllustration from './ServiceIllustration.astro';
import { path, useTranslations, type Lang, type TKey } from '../i18n/utils';

interface Props {
  lang: Lang;
  headingLevel?: 'h1' | 'h2';
  /** Background band; the illustrations' overlapping fills follow it */
  tone?: 'mist' | 'sky';
  class?: string;
}

const { lang, headingLevel = 'h2', tone = 'mist', class: className } = Astro.props;
const t = useTranslations(lang);

const packages: { illu: 'essential' | 'custom'; keys: [TKey, TKey, TKey, TKey, TKey] }[] = [
  { illu: 'essential', keys: ['pkg1_title', 'pkg1_tag', 'pkg1_basis', 'pkg1_voordeel', 'pkg1_resultaat'] },
  { illu: 'custom', keys: ['pkg2_title', 'pkg2_tag', 'pkg2_basis', 'pkg2_voordeel', 'pkg2_resultaat'] },
];

// "<strong>Fundament:</strong> text" -> term + description
const split = (html: string) => {
  const m = html.match(/^<strong>(.*?):?<\/strong>\s*(.*)$/s);
  return m ? { term: m[1].replace(/:$/, ''), desc: m[2] } : { term: '', desc: html };
};
const Title = headingLevel === 'h1' ? 'h2' : 'h3';
---

<section
  id="package"
  class:list={['py-20 sm:py-28', tone === 'mist' ? 'bg-mist [--illu-bg:var(--color-mist)]' : 'bg-sky', className]}
  aria-labelledby="package-title"
>
  <div class="wrap grid gap-12">
    <SectionHead as={headingLevel} id="package-title" title={t('package_title')} subtitle={t('package_subtitle')} />
    <div class="grid border-t-2 border-ink md:grid-cols-2">
      {
        packages.map(({ illu, keys: [title, tag, ...points] }, i) => (
          <article class:list={['grid content-start gap-6 py-10', i === 0 ? 'md:border-r md:border-rule md:pr-12' : 'border-t border-rule md:border-t-0 md:pl-12']}>
            <ServiceIllustration name={illu} class="w-48 sm:w-56" />
            <div class="grid gap-1">
              <Title class="font-display text-3xl font-extrabold font-stretch-[115%]">{t(title)}</Title>
              <p class="font-display font-semibold text-steel">{t(tag)}</p>
            </div>
            <dl class="grid gap-5">
              {points.map((p) => {
                const { term, desc } = split(t(p));
                return (
                  <div class="grid gap-1">
                    <dt class="font-display text-sm font-bold text-slate font-stretch-[105%]">{term}</dt>
                    <dd class="max-w-[46ch]">{desc}</dd>
                  </div>
                );
              })}
            </dl>
            {illu === 'essential' && (
              <p>
                <a href={path('designs', lang)} class="link">{t('pkg1_demos')}</a>
              </p>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>
