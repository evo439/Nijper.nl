---
import Arch from './Arch.astro';
import { path, useTranslations, type Lang } from '../i18n/utils';

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
---

<section id="hero" class="wrap pt-6 pb-20 sm:pb-28" aria-labelledby="hero-title">
  <Arch class="text-steel" animate />
  <p class="mt-5 font-display text-sm font-medium text-steel tabular-nums font-stretch-[80%]">
    51.8126° N, 5.8372° E &nbsp;/&nbsp; Nijmegen
  </p>
  <h1 id="hero-title" class="h1 mt-4 max-w-[15ch]">{t('hero_title')}</h1>
  <div class="mt-8 grid items-end gap-8 lg:grid-cols-[1fr_auto]">
    <p class="max-w-[48ch] text-lg leading-relaxed sm:text-xl">{t('hero_subtitle')}</p>
    <div class="flex flex-wrap gap-3">
      <a href="#contact" class="btn-primary">{t('hero_btn')}</a>
      <a href={path('check', lang)} class="btn-secondary">{t('hero_check')}</a>
    </div>
  </div>
</section>
