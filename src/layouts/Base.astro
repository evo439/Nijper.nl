---
import '../styles/global.css';
import Head from '../components/Head.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import type { Lang, PageId } from '../i18n/utils';

interface Props {
  lang: Lang;
  page: PageId;
}

const { lang, page } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <Head lang={lang} page={page} />
  </head>
  <body>
    <Nav lang={lang} page={page} />
    <main id="main" tabindex="-1" class="pt-18 outline-none">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
