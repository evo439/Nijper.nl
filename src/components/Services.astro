---
import SectionHead from './SectionHead.astro';
import ServiceIllustration from './ServiceIllustration.astro';
import { useTranslations, type Lang, type TKey } from '../i18n/utils';

interface Props {
  lang: Lang;
  class?: string;
}

const { lang, class: className } = Astro.props;
const t = useTranslations(lang);

const services: { illu: 'seo' | 'cms' | 'personal'; title: TKey; desc: TKey }[] = [
  { illu: 'seo', title: 'srv_custom1_title', desc: 'srv_custom1_desc' },
  { illu: 'cms', title: 'srv_custom2_title', desc: 'srv_custom2_desc' },
  { illu: 'personal', title: 'srv_custom3_title', desc: 'srv_custom3_desc' },
];
---

<section id="services" class:list={['py-20 sm:py-28', className]} aria-labelledby="services-title">
  <div class="wrap grid gap-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
    <SectionHead id="services-title" title={t('services_title')} subtitle={t('services_subtitle')} class="lg:sticky lg:top-28 lg:self-start" />
    <ul class="ruled">
      {
        services.map((s) => (
          <li class="grid gap-5 py-8 sm:grid-cols-[11rem_minmax(0,1fr)] sm:gap-8">
            <ServiceIllustration name={s.illu} class="w-40 sm:w-full" />
            <div class="grid content-start gap-3">
              <h3 class="h3">{t(s.title)}</h3>
              <p class="max-w-[60ch] text-slate">{t(s.desc)}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
