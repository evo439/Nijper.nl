---
import archivoUrl from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import serifUrl from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-opsz-normal.woff2?url';
import { meta, schemaFor } from '../i18n/meta';
import { routes, type Lang, type PageId } from '../i18n/utils';

interface Props {
  lang: Lang;
  page: PageId;
  /** Demo pages: keep them out of search results (fictional businesses) */
  noindex?: boolean;
  themeColor?: string;
  /** Fonts used above the fold; demo pages pass their own */
  preloadFonts?: string[];
}

const { lang, page, themeColor = '#dfe7e6', preloadFonts = [archivoUrl, serifUrl] } = Astro.props;
const isNotFound = page === 'notFound';
const noindex = Astro.props.noindex || isNotFound;
const m = meta[page][lang];
const site = 'https://nijper.nl';
const abs = (p: string) => `${site}${p}`;
const canonical = abs(routes[page][lang]);
const ogImage = `${site}/assets/${lang === 'nl' ? 'nijper-website-bouwer-nijmegen' : 'nijper-web-developer-nijmegen'}.png`;
const schema = schemaFor(page, lang);
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{m.title}</title>
<meta name="description" content={m.description} />
<meta name="keywords" content={m.keywords} />
{!isNotFound && <link rel="canonical" href={canonical} />}
{noindex && <meta name="robots" content="noindex, follow" />}

<meta property="og:title" content={m.ogTitle} />
<meta property="og:description" content={m.ogDescription} />
<meta property="og:url" content={canonical} />
<meta property="og:type" content="website" />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={m.ogTitle} />
<meta property="og:locale" content={lang === 'nl' ? 'nl_NL' : 'en_GB'} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={m.twitterTitle} />
<meta name="twitter:description" content={m.twitterDescription} />
<meta name="twitter:image" content={ogImage} />

<meta name="geo.region" content="NL-GE" />
<meta name="geo.placename" content="Nijmegen" />
<meta name="geo.position" content="51.8514;5.8713" />
<meta name="ICBM" content="51.8514, 5.8713" />

{
  !isNotFound && (
    <>
      <link rel="alternate" hreflang="nl" href={abs(routes[page].nl)} />
      <link rel="alternate" hreflang="en" href={abs(routes[page].en)} />
      <link rel="alternate" hreflang="x-default" href={abs(routes[page].nl)} />
    </>
  )
}

{schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

{preloadFonts.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta name="theme-color" content={themeColor} />
