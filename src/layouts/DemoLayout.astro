---
/**
 * Layout for the example designs: the demo site gets the full page, framed by
 * a slim Nijper banner (what this is, way back, language) and a closing CTA.
 */
import '../styles/global.css';
import Head from '../components/Head.astro';
import { path, useTranslations, type Lang, type PageId } from '../i18n/utils';

interface Props {
  lang: Lang;
  page: PageId;
  themeColor: string;
}

const { lang, page, themeColor } = Astro.props;
const t = useTranslations(lang);
const other: Lang = lang === 'nl' ? 'en' : 'nl';
---

<!doctype html>
<html lang={lang}>
  <head>
    <Head lang={lang} page={page} noindex themeColor={themeColor} />
  </head>
  <body class="bg-white">
    <a
      href="#demo"
      class="sr-only z-50 bg-ink px-4 py-3 font-display text-white focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      {lang === 'nl' ? 'Naar het voorbeeld' : 'Skip to the example'}
    </a>

    <aside class="bg-ink font-display text-sm text-mist" aria-label="Nijper">
      <div class="wrap flex flex-wrap items-center justify-between gap-x-6 gap-y-2 py-3">
        <p class="flex items-center gap-3">
          <a href={path('home', lang)} class="font-extrabold text-white font-stretch-[125%]" translate="no">Nijper</a>
          <span class="text-mist/80">{t('demo_banner')}</span>
        </p>
        <nav class="flex items-center gap-5" aria-label={lang === 'nl' ? 'Voorbeeldontwerpen' : 'Example designs'}>
          <a href={path('designs', lang)} class="underline decoration-mist/40 underline-offset-4 hover:text-lamp">{t('demo_back')}</a>
          <a href={path(page, other)} hreflang={other} lang={other} class="hover:text-lamp">
            {other.toUpperCase()}
            <span class="sr-only">{other === 'en' ? ' (English)' : ' (Nederlands)'}</span>
          </a>
        </nav>
      </div>
    </aside>

    <div id="demo" tabindex="-1" class="outline-none">
      <slot />
    </div>

    <section class="bg-steel py-16 text-white sm:py-20" aria-labelledby="demo-cta-title">
      <div class="wrap grid items-end gap-8 md:grid-cols-[minmax(0,1fr)_auto]">
        <div class="grid gap-3">
          <h2 id="demo-cta-title" class="h2">{t('demo_cta_title')}</h2>
          <p class="max-w-[52ch] text-white/85">{t('demo_cta_text')}</p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href={path('contact', lang)} class="btn bg-lamp text-ink hover:bg-white">{t('demo_cta_btn')}</a>
          <a href={path('designs', lang)} class="btn text-white shadow-[inset_0_0_0_2px_rgb(255_255_255/0.6)] hover:bg-white hover:text-steel">
            {t('demo_back')}
          </a>
        </div>
      </div>
    </section>
    <footer class="bg-ink py-6 font-display text-sm text-mist/70">
      <div class="wrap flex flex-wrap justify-between gap-2">
        <p>© 2026 <span translate="no">Nijper</span> Web Solutions</p>
        <a href={path('home', lang)} class="underline underline-offset-4 hover:text-lamp">nijper.nl</a>
      </div>
    </footer>

    <script>
      // Demo forms and ticket buttons: show a note instead of sending anything
      document.querySelectorAll<HTMLFormElement>('form[data-demo-form]').forEach((form) => {
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          const status = form.querySelector<HTMLElement>('[data-demo-status]');
          if (status) status.textContent = form.dataset.demoForm ?? '';
        });
      });
      document.querySelectorAll<HTMLButtonElement>('button[data-demo-note]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const target = document.getElementById(btn.getAttribute('aria-describedby') ?? '');
          if (target) target.textContent = btn.dataset.demoNote ?? '';
        });
      });
    </script>
  </body>
</html>
