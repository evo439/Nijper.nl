---
import SectionHeader from './SectionHeader.astro';
import { useTranslations, type Lang, type TKey } from '../i18n/utils';

interface Props {
  lang: Lang;
  class?: string;
}

const { lang, class: className } = Astro.props;
const t = useTranslations(lang);

const services: { icon: string; alt: string; title: TKey; desc: TKey }[] = [
  { icon: '/assets/SEO.webp', alt: 'SEO Optimalisatie Logo', title: 'srv_custom1_title', desc: 'srv_custom1_desc' },
  { icon: '/assets/Logo_of_Kirby_CMS-white.webp', alt: 'Kirby CMS Logo', title: 'srv_custom2_title', desc: 'srv_custom2_desc' },
  { icon: '/assets/persoonlijke-aandacht.webp', alt: 'Persoonlijke Aandacht Icon', title: 'srv_custom3_title', desc: 'srv_custom3_desc' },
];
---

<section id="services" class:list={['services', className]}>
  <div class="container">
    <SectionHeader title={t('services_title')} subtitle={t('services_subtitle')} />

    <div class="services-grid">
      {
        services.map((s, i) => (
          <div class={`service-card glass-panel fade-up delay-${i + 1}`}>
            <div class="icon">
              <img src={s.icon} alt={s.alt} style="height: 72px; width: auto;" width="72" height="72" loading="lazy" />
            </div>
            <h3>{t(s.title)}</h3>
            <p>{t(s.desc)}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
